+void Brain::mark_hidden_camps()
+{
+	auto& W = world();
+	if (cd_hidden_round.size() != W.groups.size())
+		cd_hidden_round.assign(W.groups.size(), -1000);
+	if (hp < last_hp - 0.5f && enemies_within(6) == 0)
