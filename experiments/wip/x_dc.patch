@@ -3092,6 +3092,15 @@
 		fight_margin += P.pair_caution;
 		isolated_fight_adv += P.pair_caution;
 	}
+	if (P.decoy && kit.dash >= 0 && type != CT::cassi && type != CT::issac && round >= P.decoy_from && round < P.decoy_until &&
+		hp >= P.decoy_hp * max_hp && gems < 10 && !world().obj_mode && !world().mono_mode)
+	{
+		// decoy (the user's idea, session 13): the free dash body (Ren in our draft) works the enemy half while healthy and empty-handed:
+		// their bodies leave their camps to answer it (the ladder teams' contested finish beats our unopposed pace), the dash gets it out,
+		// and the ML exit rule (ml2_leave / ml2_cornered) drops the fights that would kill it.
+		enemy_half_penalty *= P.decoy_half;
+		deny_bonus += P.decoy_deny;
+	}
 }
 
