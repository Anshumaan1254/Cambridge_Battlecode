+// Session 9 (econ2): builds of the top ladder teams (docs/strategy_v2/08_TOP3_VS_TOP3.md section 3). The damage stat is
+// focus for the casters and strength for the fighters; the passives (Treasure, Jungle, Durability) are bought in the
+// damage stat, then one Bruiser health emblem, then Power in the damage stat forever.
+bool focus_champ(CT t)
+{
+	return t == CT::ren || t == CT::stellar || t == CT::cassi || t == CT::prism || t == CT::tavi || t == CT::willow;
+}
+
+void top_build(std::vector<I>& v, CT t, int style)
+{
+	const bool f = focus_champ(t);
+	const I tr = f ? I::treasure_shard_of_focus : I::treasure_shard_of_strength;
+	const I ju = f ? I::jungle_shard_of_focus : I::jungle_shard_of_strength;
+	const I du = f ? I::durability_shard_of_focus : I::durability_shard_of_strength;
+	const I pw = f ? I::power_shard_of_focus : I::power_shard_of_strength;
+	if (style == 7)
+	{
+		rep(v, tr, 5);
+		rep(v, ju, 5);
+		rep(v, du, 5);
+		rep(v, I::bruiser_shard_of_health, 5);
+	}
+	else if (style == 8)
+	{
+		rep(v, ju, 5);
+		if (P.e2_power_after)
+			rep(v, du, 5);
+		else
+			rep(v, pw, 5), rep(v, du, 5);
+		rep(v, I::bruiser_shard_of_health, 5);
+	}
+	rep(v, pw, 300);
+}
