diff -ruN _mlkc40/src/brain.cpp _x_fin/src/brain.cpp
--- _mlkc40/src/brain.cpp	2026-10-19 23:48:38.862340349 +0000
+++ _x_fin/src/brain.cpp	2026-10-20 00:03:29.911498108 +0000
@@ -959,9 +959,24 @@
 	{
 		if (!e.alive || e.seen_round < 0)
 			continue;
-		const int age = round - e.seen_round;
-		if (age > P.threat_memory)
+		int age = round - e.seen_round;
+		bool ghost = false;
+		if (P.bush_ghost > 0 && !e.visible && age > 1 && age <= P.bush_ghost)
+		{
+			// bush_ghost: an enemy that vanished in or next to a bush is probably waiting there (the ladder teams spend 2.4x our bush
+			// time and open from it): keep it in the danger map, its reach not growing past +2 (it is not walking toward us).
+			const auto& B = bc::map::bushes();
+			for (int dy = -1; dy <= 1 && !ghost; ++dy)
+				for (int dx = -1; dx <= 1 && !ghost; ++dx)
+				{
+					const vec2 q{ e.pos.x + dx, e.pos.y + dy };
+					ghost = bc::map::is_in_bounds(q) && B.is_set(q);
+				}
+		}
+		if (age > P.threat_memory && !ghost)
 			continue;
+		if (ghost)
+			age = std::min(age, 2);
 		// Cooldowns are known while visible; an unseen enemy is assumed to have everything ready.
 		const bool fresh = age == 0;
 		// mi_cd_slack (default branch): a spell coming off cooldown next turn is as good as up (we move once before it acts).
@@ -2583,6 +2598,30 @@
 			// uncastable this turn, and next turn it competes with the attack reset (one cast per turn); stunning
 			// now lands it a turn earlier and next turn is step + attack + reset + attack. The old check below only
 			// knew single-target stuns: Ryth walked in with the stun ready in 279 fight turns of 3 traced games.
+			bool mhold = false;
+			if ((P.open_first & 4) && d > 4 && !danger.is_set(pos) && (ready(kit.cc) || ready(kit.dmg) || ready(kit.aoe)) && !e.channeling && !e.tributing)
+			{
+				// open_first 4: a melee body with a range-4 cast ready (Ren's stun, Ryth's area stun) holds where the next step would enter an
+				// enemy's next-turn reach: the side that steps in takes the first volley (ladder: openers win the first 3 rounds ~4:1).
+				bool step_in = false;
+				for (const auto& o : world().enemies)
+				{
+					if (!o.alive || !o.visible)
+						continue;
+					int r = o.kit.attack_range + (o.kit.ranged ? 0 : 1) + (o.ready(o.kit.dash) ? 2 : 0);
+					r = std::max(r, P.aoe_reach5 ? enemy_spell_reach(o, false) : ((o.ready(o.kit.dmg) || o.ready(o.kit.cc) || o.ready(o.kit.aoe)) ? 4 : 0));
+					step_in |= cheb(pos, o.pos) - 1 <= r;
+				}
+				if (round - of_round > 1)
+					of_since = round;
+				of_round = round;
+				mhold = step_in && round - of_since < P.open_hold;
+			}
+			if (mhold)
+			{
+				dbg_eng = 9;
+				return true;
+			}
 			if (P.melee_aoe_stun && kit.aoe_stuns && d >= 2 && ready(kit.aoe) && e.type != CT::marcella && cast_area_stun_at(e))
 				dbg_eng = 7;
 			else if (d == 2 || !(d <= 4 && (ready(kit.cc) || ready(kit.dmg))))
