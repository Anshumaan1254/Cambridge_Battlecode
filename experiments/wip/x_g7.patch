 bool Brain::in_awake_camp_range() const { return camp_danger.is_set(pos); }
 
+// P.cd_hidden: a camp we cannot see (a wall or a bush between us) keeps its last known state, so one woken by someone else hits us while
+// the world model says it sleeps: no camp danger, safe_to_recall() (ladder: Cassi recalled 13 times next to a wolf behind a wall, each
+// recall cancelled by its next hit; Stellar 3 times behind a bush row). Health lost since our last turn with no visible enemy near is
+// that hit: every live camp we cannot see whose range covers the tile we stood on counts as awake for P.cd_hidden rounds.
+void Brain::mark_hidden_camps()
+{
+	auto& W = world();
+	if (cd_hidden_round.size() != W.groups.size())
+		cd_hidden_round.assign(W.groups.size(), -1000);
+	if (hp < last_hp - 0.5f && enemies_within(6) == 0)
+		for (const auto& g : W.groups)
+			if (g.st == ST_ALIVE && !g.harmless && !g.awake && cheb(g.center, pos) <= 12)
+				for (std::size_t i = 0; i < g.camps.size(); ++i)
+					if (g.hp[i] > 0 && g.camps[i].str > 0 && cheb(g.camps[i].pos, pos) <= g.camps[i].range && !W.vis.is_set(g.camps[i].pos))
+					{
+						cd_hidden_round[static_cast<std::size_t>(g.id)] = round;
+						break;
+					}
+	if (cd_hidden_forced.size() != W.groups.size())
+		cd_hidden_forced.assign(W.groups.size(), 0);
+	for (auto& g : W.groups)
+	{
+		auto& forced = cd_hidden_forced[static_cast<std::size_t>(g.id)];
+		if (g.st == ST_ALIVE && round - cd_hidden_round[static_cast<std::size_t>(g.id)] < P.cd_hidden)
+		{
+			if (!g.awake)
+				g.awake = true, forced = 1;
+		}
+		else if (forced)
+		{
+			// The mark lapsed: back to what the world model knew (World::update keeps an unseen group's flag, so the forced
+			// value would otherwise stay for as long as the group stays out of sight).
+			if (g.seen_round != round)
+				g.awake = false;
+			forced = 0;
+		}
+	}
+}
