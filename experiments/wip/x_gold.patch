+	// Tiebreak-aware economy (gem-scarce maps). At the round limit the engine ranks: banked gems, then gold EARNED
+	// over the game (statistics earnedGold: captures and 50 per kill, with the Treasure / Vesper +20%; spending does
+	// not reduce it), then kills, then team B wins. One banked gem beats any amount of gold.
+	int tb_enabled = 1;			  // master switch (0 = legend behaviour everywhere)
+	// Static detection at init: "scarce" when our half's non-monolith gem supply (sum of gems / respawn rounds over
+	// the groups nearer our spawn, monolith groups excluded) times tb_eff times max_rounds stays below winning_gems.
+	// tb_eff = share of that theoretical rate a team actually banks: legend's finish rounds on the 45-map panel give
+	// 0.27-0.39 (isl_40x40 2.54 gems/round -> r1037, gen00 2.71 -> r1101, lad_30x30 3.00 -> r863, packs 4.26 -> r759).
+	// With 0.3 only the monolith-only ladder map (lad_50x50_R_c5_65bb75, rate 0) triggers among the 45 panel maps.
+	float tb_eff = 0.3f;
+	// Dynamic check: from this round, also count as a tiebreak game when neither team's projected banked total
+	// (banked + banked-per-round so far x rounds left) reaches tb_dyn_frac x winning_gems by max_rounds.
+	int tb_dyn_from = 1300;
+	float tb_dyn_frac = 0.9f;
+	int tb_tribute_min = 1;		  // scarce maps: bank any bag (every banked gem is decisive; a death throws the bag away)
+	int tb_bag_caution = 20;	  // scarce maps: carrying this many gems, avoid even fights we can escape (was bag_caution)
+	int tb_treasure = 1;		  // scarce maps: Treasure emblem first (earned gold +20%: clusters 35 -> 42, kills 50 -> 60)
+	int tb_endgame = 250;		  // last rounds of a tiebreak game: ahead on gems protect, behind go all-in for gems
+	float tb_gold_value = 0.22f;  // gold value in group scoring on scarce maps (normal: gold_value)
+	float tb_behind_gold_value = 0.05f; // ... in the endgame when behind on gems (only gems can still win)
+	int tb_hunt_bag = 30;		  // scarce maps: a visible enemy carrying this many gems is posted as an opportunity
+	float tb_deny_mult = 3.0f;	  // scarce maps: value multiplier for stepping on an enemy's gem capture (monolith: 200)
+	// Team monolith (scarce maps): plan it with the damage of every living ally, not one body's solo plan (legend
+	// took its first monolith at r780-1200 on the gold maps: a body must solo it in 5 heal trips before claiming it),
+	// gather outside its range until tb_mono_min bodies claim it, then wake it together.
