+void Comms::write_mono_call(bool on)
+{
+	const std::uint8_t old = bc::shared_memory[2];
+	const std::uint8_t v = static_cast<std::uint8_t>((old & 0x7F) | (on ? 0x80 : 0));
+	if (v != old)
+		bc::shared_memory[2] = v;
+	mono_call = on;
+}
