+
+	// Tiebreak-aware economy. Lexicographic: banked gems, then gold earned, then kills, then team B.
+	tb_lead = ours - theirs;
+	tb_phase = 0;
+	const bool was_deciding = tb_decides;
+	tb_decides = tb_scarce;
+	const int max_r = static_cast<int>(bc::constants::max_rounds);
+	if (P.tb_enabled && !tb_decides && round >= P.tb_dyn_from && round < max_r)
+	{
+		const float left = static_cast<float>(max_r - round), r = static_cast<float>(std::max(1, round));
+		const float po = static_cast<float>(ours) * (1.f + left / r), pt = static_cast<float>(theirs) * (1.f + left / r);
+		tb_decides = std::max(po, pt) < P.tb_dyn_frac * static_cast<float>(bc::constants::winning_gems);
+	}
+	if (tb_scarce)
+	{
+		// Every banked gem outranks all the gold: bank any bag at once, and do not risk a bag in fights.
+		gold_value = P.tb_gold_value;
+		tribute_min = std::min(tribute_min, P.tb_tribute_min);
+		bag_caution = std::min(bag_caution, P.tb_bag_caution);
+	}
+	if (tb_decides && round >= max_r - P.tb_endgame)
+	{
+		if (tb_lead > 0)
+		{
+			// Ahead on gems: only their gems can change the result. Keep the team alive and at home; no
+			// optional fights (each of our deaths is also 50 earned gold and a kill for them).
+			tb_phase = 1;
+			fight_margin += 0.4f;
+			isolated_fight_adv += 0.4f;
+			enemy_half_penalty *= 3.f;
+			deny_bonus *= 0.5f;
+		}
+		else if (tb_lead == 0)
+			tb_phase = 2; // tied: gold earned decides; play the normal (gold-farming) game
+		else
+		{
+			// Behind on gems: gold cannot win any more. All-in for gems: their camps, carriers and captures.
+			tb_phase = 3;
+			gold_value = P.tb_behind_gold_value;
+			fight_margin = std::max(0.9f, fight_margin - 0.3f);
+			fight_back_margin = std::max(0.55f, fight_back_margin - 0.15f);
+			deny_bonus += 0.6f;
+			enemy_half_penalty *= 0.4f;
+		}
+	}
+#ifdef GOLD_TRACE
+	if (tb_decides != was_deciding)
+		debug_block({ std::printf("TB r=%d decides=%d scarce=%d ours=%d theirs=%d\n", round, static_cast<int>(tb_decides), static_cast<int>(tb_scarce), ours, theirs); });
+#else
+	(void)was_deciding;
+#endif
 }
 
