+	int tb_hunt_bag = 30;		  // scarce maps: a visible enemy carrying this many gems is posted as an opportunity
+	float tb_deny_mult = 3.0f;	  // scarce maps: value multiplier for stepping on an enemy's gem capture (monolith: 200)
