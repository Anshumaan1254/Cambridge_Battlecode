+void Brain::detect_scarcity()
+{
+	// Gem supply our team can realistically bank: the theoretical rate of the non-monolith gem groups nearer our
+	// spawn (each respawns every `respawn` rounds) times tb_eff. Monoliths (20,000 health, 200 strength) are left
+	// out: they fall only to a whole, well-equipped team, so a map whose gems come from them alone is decided by
+	// whoever takes them, and otherwise by the tiebreakers.
+	auto& W = world();
+	tb_rate = 0.f;
+	for (const auto& g : W.groups)
+		if (g.ours && !g.monolith && g.gems > 0 && g.respawn > 0)
+			tb_rate += static_cast<float>(g.gems) / static_cast<float>(g.respawn);
+	const float reach = P.tb_eff * tb_rate * static_cast<float>(bc::constants::max_rounds);
+	tb_scarce = P.tb_enabled && reach < static_cast<float>(bc::constants::winning_gems);
+#ifdef GOLD_TRACE
+	debug_block({ std::printf("TB init rate=%.2f reach=%.0f scarce=%d\n", static_cast<double>(tb_rate), static_cast<double>(reach), static_cast<int>(tb_scarce)); });
+#endif
+}
