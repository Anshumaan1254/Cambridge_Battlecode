+void Brain::track_claims()
+{
+	auto& C = comms();
+	auto& W = world();
+	for (std::size_t i = 0; i < claim_prev.size(); ++i)
+		if (C.claim[i] != claim_prev[i])
+		{
+			const int old = claim_prev[i];
+			if (P.claim_release && old >= 0 && old < static_cast<int>(W.groups.size()) && static_cast<int>(i) != W.my_index && i < W.allies.size() && W.allies[i].alive)
+			{
+				auto& g = W.groups[static_cast<std::size_t>(old)];
+				if (g.st == ST_REWARD && g.seen_round < round)
+					g.st = ST_RESPAWN, g.ready_round = round + g.respawn;
+			}
+			claim_prev[i] = C.claim[i], claim_since[i] = round;
+		}
+}
