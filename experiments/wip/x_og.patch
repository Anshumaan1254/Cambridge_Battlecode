+// og (opening economy): stat points a body has bought (1 per shard; Bruiser / Power emblems add their bonus points), from its
+// current max health / strength / focus and its design's base and growth. Base stats are a host call: cached per type.
+static float og_item_points(bc::champion_type t, float max_hp, float str, float focus)
+{
+	static std::array<bool, 12> have{};
+	static std::array<bc::champion_stats, 12> bs{};
+	const auto k = static_cast<std::size_t>(t);
+	if (k >= 12)
+		return 0.f;
+	if (!have[k])
+	{
+		try
+		{
+			bs[k] = bc::champion_designs[k].base_stats();
+		}
+		catch (...)
+		{
+			return 0.f;
+		}
+		have[k] = true;
+	}
+	const auto& b = bs[k];
+	float p = 0.f;
+	if (b.health_growth > 0.f)
+		p += std::max(0.f, max_hp - b.base_health) / b.health_growth;
+	if (b.strength_growth > 0.f)
+		p += std::max(0.f, str - b.base_strength) / b.strength_growth;
+	if (b.focus_growth > 0.f)
+		p += std::max(0.f, focus - b.base_focus) / b.focus_growth;
+	return p;
+}
