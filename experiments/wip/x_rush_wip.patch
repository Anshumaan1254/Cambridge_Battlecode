+bool Brain::mono_feasible(int& need) const
+{
+	// Can the living team take our monolith in at most 1 + tb_mono_trips rotations? Damage: every living body
+	// (allies from their design scaled by our growth when unseen). Tank budget: each body's health above its
+	// retreat line (safety(): 4 rounds of raw camp damage, or retreat_hp); the monolith hits the nearest champion,
+	// tanks rotate out to heal and come back. Legend's solo test (one body within max_trips heal trips) first
+	// passed at r780-1200 on the gold maps; this one at r300-400 (traced on gold_mono_64x64).
+	auto& W = world();
+	need = 0;
+	if (mono_gid < 0)
+		return false;
+	const Group& g = W.groups[static_cast<std::size_t>(mono_gid)];
+	const float line = 4.f * g.dps;
+	auto usable = [&](float mhp) { return std::max(0.f, mhp - std::max(P.retreat_hp * mhp, line)); };
+	const float my_base = bc::champion_designs[static_cast<std::size_t>(type)].base_stats().base_health;
+	const float hgrow = max_hp / std::max(1.f, my_base);
+	float dps = 0, budget = 0;
+	int alive_n = 0;
+	for (int i = 0; i < static_cast<int>(W.allies.size()) && i < 6; ++i)
+	{
+		const auto& a = W.allies[static_cast<std::size_t>(i)];
+		if (!a.alive)
+			continue;
+		++alive_n;
+		if (i == W.my_index)
+		{
+			dps += std::max(10.f, dps_on(g));
+			budget += usable(max_hp);
+			continue;
+		}
+		dps += ally_dps_on(i, g);
+		budget += usable(a.visible ? a.max_hp : bc::champion_designs[static_cast<std::size_t>(a.type)].base_stats().base_health * hgrow);
+	}
+	need = std::max(2, (static_cast<int>(W.allies.size()) * 3 + 4) / 5); // 60% of the bodies, rounded up
+	if (alive_n < need)
+		return false;
+	const float hp_left = g.st == ST_RESPAWN ? g.max_hp : g.hp_total;
+	const float kill = hp_left / std::max(10.f, dps);
+	const float rot = std::max(1.f, incoming_on(g)) * kill / std::max(1.f, budget);
+	return rot <= 1.f + static_cast<float>(P.tb_mono_trips);
+}
