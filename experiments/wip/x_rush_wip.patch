+bool Brain::mono_task()
+{
+	// Answer the team monolith call: gather just outside its range (camps wake only from damage), wake it once
+	// enough of us are there (or it is already awake), and fight it like any camp group (safety() rotates us out).
+	auto& W = world();
+	if (!comms().mono_call || mono_gid < 0 || static_cast<int>(gems) > 0)
+		return false;
+	Group& g = W.groups[static_cast<std::size_t>(mono_gid)];
+	if (g.st == ST_REWARD || (g.st == ST_RESPAWN && g.ready_round - round > 15))
+		return false; // the capture goes through normal scoring; respawning: farm meanwhile
+	if (hp < 0.7f * max_hp && !g.awake)
+		return false; // heal first (home_trip / safety), then come
+	int need = std::max(2, (static_cast<int>(W.allies.size()) * 3 + 4) / 5);
+	int present = 1;
+	const auto& C = comms();
+	for (int i = 0; i < static_cast<int>(W.allies.size()) && i < 6; ++i)
+	{
+		const auto& a = W.allies[static_cast<std::size_t>(i)];
+		if (i == W.my_index || !a.alive)
+			continue;
+		if ((a.visible && cheb(a.pos, g.center) <= 5) || C.claim[static_cast<std::size_t>(i)] == mono_gid)
+			++present;
+	}
+	int alive_n = 0;
+	for (const auto& a : W.allies)
+		alive_n += a.alive;
+	need = std::min(need, alive_n);
+	task_group = mono_gid;
+	if (present < need && !g.awake && g.st != ST_RESPAWN && g.hp_total >= g.max_hp - 1.f)
