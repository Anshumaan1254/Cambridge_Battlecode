+void Brain::update_mono_call()
+{
+	auto& C = comms();
+	bool on = false;
+	if (tb_scarce && P.tb_mono_team && mono_gid >= 0)
+	{
+		auto& W = world();
+		const Group& g = W.groups[static_cast<std::size_t>(mono_gid)];
+		int need = 0;
+		const bool up = g.st == ST_ALIVE || g.st == ST_UNKNOWN || (g.st == ST_RESPAWN && g.ready_round - round <= 15);
+		int us = 0, them = 0;
+		for (const auto& a : W.allies)
+			us += a.alive;
+		for (const auto& e : W.enemies)
+			them += e.alive;
+		// Not while they outnumber us (their pack meets our tanks at 200 damage a round), nor too late to bank
+		// 200 gems (20 tribute rounds) before the limit.
+		const bool late = round > static_cast<int>(bc::constants::max_rounds) - 90;
+		if (up && them <= us && !late && mono_feasible(need))
+			on = true;
+		// A call that has not killed it in 150 rounds rests for a while (the team returns to gold).
+		if (on && C.mono_call && round - mono_call_since > 150)
+			on = false;
+		if (!on && C.mono_call)
+			mono_call_since = round; // marks the end; a new call needs 40 rounds of rest
+		else if (on && !C.mono_call && round - mono_call_since < 40 && mono_call_since > 0)
+			on = false;
+	}
+	if (on && !C.mono_call)
+		mono_call_since = round;
+	if (on != C.mono_call)
+	{
+#ifdef GOLD_TRACE
+		debug_block({ std::printf("MC r=%d call=%d\n", round, static_cast<int>(on)); });
+#endif
+		C.write_mono_call(on);
+	}
+}
