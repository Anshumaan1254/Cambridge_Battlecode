+bool Brain::hunt_party(const Enemy& tgt, float& adv_h, int& party) const
+{
+	// Is `tgt` a lone enemy champion that a party of ours can kill? Alone: no other enemy champion alive within 10 of
+	// it that we saw in the last threat_memory rounds. Party: ourselves and the visible allies within rush_hunt_ally_r
+	// of it, healthy (>= 50%). adv_h = the combat() ratio (hp / dps) over that party. Never on their spawn.
+	auto& W = world();
+	adv_h = 0, party = 0;
+	if (!tgt.alive || !tgt.ch || W.enemy_spawn.is_set(tgt.pos) || cheb(tgt.pos, W.enemy_spawn_c) <= 6)
+		return false;
+	for (const auto& e : W.enemies)
+		if (&e != &tgt && e.alive && round - e.seen_round <= P.threat_memory && cheb(e.pos, tgt.pos) <= 10)
+			return false;
+	if (hp < 0.5f * max_hp)
+		return false;
+	float ohp = hp, odps = str + focus * best_mod(kit) / 8.f;
+	party = 1;
+	for (const auto& a : W.allies)
+		if (a.handle != self && a.alive && a.visible && a.hp >= 0.5f * a.max_hp && cheb(a.pos, tgt.pos) <= P.rush_hunt_ally_r)
+		{
+			ohp += a.hp, odps += a.str + a.focus * best_mod(a.kit) / 8.f;
+			++party;
+		}
+	const float tdps = tgt.str + tgt.focus * best_mod(tgt.kit) / 8.f + tgt.burst() / 3.f;
+	adv_h = (ohp / std::max(1.f, tdps)) / std::max(0.1f, tgt.hp / std::max(1.f, odps)) * learner().fight_scale();
+	return true;
+}
+
+bool Brain::hunt()
+{
+	// Walk toward a lone enemy champion beyond combat()'s sight (9..rush_hunt_range) when a party of ours can take it,
+	// and call the nearby allies (RALLY) so they converge. A chase lasts at most rush_hunt_len rounds, then rests.
+	auto& W = world();
+	if (round < hunt_rest_until || task == T_CAPTURE || reward_here() || static_cast<int>(gems) >= bag_caution)
+		return false;
+	if (round - hunt_last > 3)
+		hunt_since = round;
+	if (round - hunt_since > P.rush_hunt_len)
+	{
+		hunt_rest_until = round + P.rush_hunt_rest;
+		return false;
+	}
+	Enemy* best = nullptr;
+	int best_d = BIG;
+	for (auto& e : W.enemies)
+	{
+		if (!e.alive || !e.visible || !e.ch)
+			continue;
+		const int d = cheb(e.pos, pos);
+		if (d > P.rush_hunt_range || d >= best_d)
+			continue;
+		float adv_h = 0;
+		int party = 0;
+		if (!hunt_party(e, adv_h, party) || party < 2 || adv_h < P.rush_hunt_adv)
+			continue;
+		best = &e, best_d = d;
+	}
+	if (!best)
+		return false;
+	hunt_last = round;
+	comms().post(AL_RALLY, best->pos, round);
+	task = T_FIGHT;
+	bc::bitboard goal;
+	goal.draw_chebyshev(best->pos, static_cast<float>(kit.attack_range));
+	return step(goal, false, true);
+}
