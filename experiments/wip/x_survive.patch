+	int outmatch_flee = 0;			 // also walk away (not alone) when the visible group here outmatches us: adv below
+	float outmatch_flee_adv = 0.8f;	 // ... this, with at least outmatch_min_enemies visible enemies within 9 and the
+	int outmatch_min_enemies = 2;	 // ... nearest within outmatch_flee_dist (not yet in reach: in reach the old rules apply)
+	int outmatch_flee_dist = 8;
+	float pair_flee_bonus = 0.f;	 // Cassi & Issac (two bodies, two bags per death): this much more advantage to stay
