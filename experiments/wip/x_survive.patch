+	const bool pair_body = type == CT::cassi || type == CT::issac;
+	const bool outmatched = P.outmatch_flee && static_cast<int>(E.size()) >= P.outmatch_min_enemies && nearest_enemy <= P.outmatch_flee_dist &&
