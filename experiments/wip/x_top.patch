+// ---- items ----------------------------------------------------------------------------------------------------------
+void Bot::shop()
+{
+	auto& me = bc::self();
+	using I = bc::item_type;
+	const bool str_stat = strength_champion(my_type);
+	const I power = str_stat ? I::power_shard_of_strength : I::power_shard_of_focus;
+	std::vector<I> order; // emblem by emblem; after the list: Power in the damage stat forever
+	if (my_type == bc::champion_type::tavi)
+		order = { I::treasure_shard_of_focus };
+	else
+	{
+		order = { I::durability_shard_of_health };
+		if (my_type == bc::champion_type::ren || my_type == bc::champion_type::ryth || my_type == bc::champion_type::cassi)
+			order.push_back(I::bruiser_shard_of_health);
+	}
+	for (int guard = 0; guard < 8; ++guard)
+	{
+		const std::size_t idx = static_cast<std::size_t>(bought / 5);
+		const I item = idx < order.size() ? order[idx] : power;
+		const int left = 5 - bought % 5;
+		const int n = std::min<int>(left, gold / static_cast<int>(item.cost()));
+		if (n <= 0)
+			break;
+		try
+		{
+			if (!me.can_buy(item, static_cast<std::uint32_t>(n)))
+				break;
+			me.buy(item, static_cast<std::uint32_t>(n));
+			bought += n;
+			gold -= n * static_cast<int>(item.cost());
+		}
+		catch (...)
+		{
+			break;
+		}
+	}
+	refresh_self(true);
+}
