+// ---- kits (from the engine design, never hard-coded) ---------------------------------------------------------
+struct Kit
+{
+	int reset = -1, dash = -1, dmg = -1, cc = -1, aoe = -1, shield = -1, heal = -1;
+	float dmg_range = 0, dmg_mod = 0, cc_range = 0, cc_mod = 0, aoe_range = 0, aoe_mod = 0, aoe_radius = 1;
+	bool dmg_x = false, cc_x = false, aoe_x = false;
+	int range = 1;
+	bool done = false;
+};
+
+Kit make_kit(bc::champion_type t)
+{
+	Kit k;
+	const auto& c = bc::champion_designs[static_cast<std::size_t>(t)];
+	k.range = c.base_stats().base_attack_range;
+	for (const auto& a : c.abilities())
+	{
+		const auto& inf = a.info();
+		if (!inf)
+			continue;
+		const int slot = static_cast<int>(a.slot());
+		std::visit(
+			[&](const auto& v) {
+				using T = std::decay_t<decltype(v)>;
+				if constexpr (std::is_same_v<T, bc::ability_attack_reset>)
+					k.reset = slot;
+				else if constexpr (std::is_same_v<T, bc::ability_dash>)
+					k.dash = slot;
+				else if constexpr (std::is_same_v<T, bc::ability_shield>)
+					k.shield = slot;
+				else if constexpr (std::is_same_v<T, bc::ability_heal>)
+					k.heal = slot;
+				else if constexpr (std::is_same_v<T, bc::ability_damage>)
+					k.dmg = slot, k.dmg_range = v.range, k.dmg_mod = v.modifier, k.dmg_x = v.exclusive_with_movement;
+				else if constexpr (std::is_same_v<T, bc::ability_cc>)
+					k.cc = slot, k.cc_range = v.range, k.cc_mod = v.modifier, k.cc_x = v.exclusive_with_movement;
+				else if constexpr (std::is_same_v<T, bc::ability_aoe_damage>)
+					k.aoe = slot, k.aoe_range = v.range, k.aoe_mod = v.modifier, k.aoe_radius = v.radius,
+					k.aoe_x = v.exclusive_with_movement;
+			},
+			*inf);
+	}
+	k.done = true;
+	return k;
+}
+
+std::array<Kit, 12> g_kits;
+const Kit& kit_of(bc::champion_type t)
+{
+	auto& k = g_kits[static_cast<std::size_t>(t)];
+	if (!k.done)
+		k = make_kit(t);
+	return k;
+}
+
+// Damage per round of a body against a target (basic attack + one spell/reset per 8-round cooldown).
+float dps_of(const Kit& k, float str, float focus)
+{
+	float d = str;
+	if (k.reset >= 0) d += str / 8.f;
+	if (k.dmg >= 0) d += focus * k.dmg_mod / 8.f;
+	if (k.aoe >= 0) d += focus * k.aoe_mod / 8.f;
+	if (k.cc >= 0) d += focus * k.cc_mod / 8.f + 4.f;
+	return std::max(1.f, d);
+}
+
+// Collector rank: who turns a capture's gold into the most farming (Varg > Issac > Stellar > Ryth > Cassi > Ren).
+int rank_of(bc::champion_type t)
+{
+	switch (t)
+	{
+	case bc::champion_type::varg: return 7;
+	case bc::champion_type::issac: return 6;
+	case bc::champion_type::stellar: return 5;
+	case bc::champion_type::ryth: return 4;
+	case bc::champion_type::cassi: return 3;
+	case bc::champion_type::ren: return 2;
+	default: return 1;
+	}
+}
+
+bool strength_champion(bc::champion_type t)
+{
+	switch (t)
+	{
+	case bc::champion_type::ryth:
+	case bc::champion_type::vesper_vale:
+	case bc::champion_type::vendetta:
+	case bc::champion_type::issac:
+	case bc::champion_type::marcella:
+	case bc::champion_type::varg: return true;
+	default: return false;
+	}
+}
