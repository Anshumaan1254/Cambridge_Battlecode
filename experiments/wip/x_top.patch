+// True when a single camp group pays at least 40% of all gems on the map (an "objective" map: Tavi shops in the field).
+bool objective_map()
+{
+	try
+	{
+		unsigned total = 0, best = 0;
+		for (const auto& g : cambc::map::camp_groups())
+		{
+			total += g.gem_value();
+			best = std::max(best, g.gem_value());
+		}
+		return total > 0 && best * 10 >= total * 4;
+	}
+	catch (...)
+	{
+		return false;
+	}
+}
+} // namespace
+
+void play_draft()
+{
+	const auto chosen = cambc::draft::current_draft(cambc::team::ally);
+	const unsigned size = cambc::draft::team_size();
+	std::array<D, 5> order{ D::varg, D::stellar, D::cassi_and_issac, D::ryth, D::ren };
+	if (size >= 5 && objective_map())
+		order[4] = D::tavi;
+	// Next pick: the first of our order not taken yet (picks are made one per draft turn).
+	for (unsigned i = 0; i < std::min<unsigned>(5, std::max<unsigned>(size, 3)); ++i)
+	{
+		if (std::find(chosen.begin(), chosen.end(), order[i]) != chosen.end())
+			continue;
+		cambc::draft::pick(order[i]);
+		return;
+	}
+	// Fallback (should not happen): any champion not yet taken.
+	for (int i = 0; i < 11; ++i)
+	{
+		const auto pick = static_cast<D>(i);
+		if (std::find(chosen.begin(), chosen.end(), pick) == chosen.end())
+		{
+			cambc::draft::pick(pick);
+			return;
+		}
+	}
 }
