+// Focus target: lowest health in reach, Cassi or Issac first; Varg aims where its splash hits most enemies.
+int Bot::pick_focus(const std::vector<int>& idx)
+{
+	int best = -1;
+	float best_s = 1e30f;
+	for (int i : idx)
+	{
+		const auto& e = enemies[static_cast<std::size_t>(i)];
+		float s = e.hp;
+		if (e.type == bc::champion_type::cassi || e.type == bc::champion_type::issac)
+			s -= 150.f;
+		if (my_type == bc::champion_type::varg)
+		{
+			int k = 0;
+			for (int j : idx)
+				k += cheb(enemies[static_cast<std::size_t>(j)].pos, e.pos) <= 1;
+			s -= 120.f * static_cast<float>(k - 1);
+		}
+		if (s < best_s)
+			best_s = s, best = i;
+	}
+	return best;
+}
 
