+// ---- movement -------------------------------------------------------------------------------------------------------
+// Try the free neighbours in order of increasing cost (cost >= BIG skips the tile).
+bool Bot::walk(const std::function<int(vec2)>& cost, bool allow_equal)
+{
+	(void)allow_equal;
+	static constexpr std::array<vec2, 8> D{ vec2::north, vec2::north_east, vec2::east, vec2::south_east,
+											vec2::south, vec2::south_west, vec2::west, vec2::north_west };
+	if (!flag(state, bc::champion_state::can_move))
+		return false;
+	std::array<std::pair<int, int>, 8> cand{};
+	int n = 0;
+	for (int i = 0; i < 8; ++i)
+	{
+		const vec2 p = pos + D[static_cast<std::size_t>(i)];
+		if (!is_free(p))
+			continue;
+		const int c = cost(p);
+		if (c >= BIG)
+			continue;
+		cand[static_cast<std::size_t>(n++)] = { c * 8 + ((i + round) & 7), i };
+	}
+	std::sort(cand.begin(), cand.begin() + n);
+	auto& me = bc::self();
+	for (int k = 0; k < n; ++k)
+	{
+		const vec2 d = D[static_cast<std::size_t>(cand[static_cast<std::size_t>(k)].second)];
+		try
+		{
+			if (me.move(d))
+			{
+				prev_pos = pos;
+				pos = pos + d;
+				dyn_ready = false;
+				refresh_self();
+				return true;
+			}
+		}
+		catch (...)
+		{
+		}
+	}
+	return false;
+}
+
+bool Bot::walk_field(const Field& f, int stop_at)
+{
+	const int here = f.get(pos);
+	if (here <= stop_at || here >= BIG)
+		return false;
+	if (walk([&](vec2 p) { const int v = f.get(p); return v < here ? v : BIG; }))
+		return true;
+	// Blocked by units: sidestep along equal-value tiles (never straight back to where we came from).
+	return walk([&](vec2 p) { const int v = f.get(p); return (v == here && p != prev_pos) ? v : BIG; });
+}
 
