+// ---- init ---------------------------------------------------------------------------------------------------------
+void Bot::init()
+{
+	inited = true;
+	W = bc::map::width();
+	H = bc::map::height();
+	enemy_spawn = bc::map::spawn_region(team::enemy);
+	ally_spawn = bc::map::spawn_region(team::ally);
+	walls = bc::map::walls() | bc::map::holes() | bc::map::altars() | enemy_spawn;
+	auto& me = bc::self();
+	me_h = hid(me);
+	{
+		bc::detail::champion_info ci{};
+		if (read_ch(me_h, ci))
+			my_type = static_cast<bc::champion_type>(ci.type);
+	}
+	kit = kit_of(my_type);
+
+	std::uint32_t n = 0;
+	bc::detail::sdk_num_allies(&n);
+	std::vector<std::uint32_t> hs(n);
+	bc::detail::sdk_allies(hs.data(), n, &n);
+	for (std::uint32_t i = 0; i < n; ++i)
+	{
+		Ent e;
+		e.h = hs[i];
+		bc::detail::champion_identity id{};
+		if (bc::detail::sdk_champion_identity(hs[i], &id) == 0)
+			e.type = static_cast<bc::champion_type>(id.type);
+		allies.push_back(std::move(e));
+		if (hs[i] == me_h)
+			my_index = static_cast<int>(i);
+	}
+	bc::detail::sdk_num_enemies(&n);
+	hs.assign(n, 0);
+	bc::detail::sdk_enemies(hs.data(), n, &n);
+	for (std::uint32_t i = 0; i < n; ++i)
+	{
+		Ent e;
+		e.h = hs[i];
+		enemies.push_back(std::move(e));
+	}
+
+	// Distance fields from each spawn (walking steps; units ignored).
+	{
+		bc::bitboard roots = ally_spawn, visited;
+		home.f.compute(walls & ~roots, roots, visited);
+		home.ready = true;
+		bc::bitboard roots2 = enemy_spawn, visited2;
+		away.f.compute(walls & ~roots2, roots2, visited2);
+		away.ready = true;
+	}
+
+	// Altars: approach tiles (within submit range of the altar); skip altars on the enemy half when others exist.
+	altars = bc::map::altars().positions();
+	altar_bad.assign(altars.size(), 0);
+	altar_good.assign(altars.size(), false);
+	const int rng = std::max<int>(1, bc::constants::submit_gems_range);
+	bc::bitboard roots_all;
+	std::vector<bc::bitboard> approach(altars.size());
+	bool any_good = false;
+	for (std::size_t i = 0; i < altars.size(); ++i)
+	{
+		int dh = BIG, da = BIG;
+		for (int dy = -rng; dy <= rng; ++dy)
+			for (int dx = -rng; dx <= rng; ++dx)
+			{
+				const vec2 p{ altars[i].x + dx, altars[i].y + dy };
+				if (!bc::map::is_in_bounds(p) || walls.is_set(p))
+					continue;
+				approach[i].set(p);
+				dh = std::min(dh, home.get(p));
+				da = std::min(da, away.get(p));
+			}
+		altar_good[i] = dh < BIG && dh <= da + 4;
+		any_good |= altar_good[i];
+	}
+	for (std::size_t i = 0; i < altars.size(); ++i)
+		if (altar_good[i] || !any_good)
+			roots_all |= approach[i];
+	if (!roots_all.is_empty())
+	{
+		bc::bitboard visited;
+		altar_f.f.compute(walls, roots_all, visited);
+		altar_f.ready = true;
+	}
+
+	// Camp groups.
+	const auto all = bc::map::camp_groups();
+	std::array<std::optional<bc::camp_stats>, 5> cs;
+	groups.reserve(all.size());
+	int id = 0;
+	for (const auto& g : all)
+	{
+		Group G;
+		G.handle = static_cast<std::uint32_t>(static_cast<bc::handle_camp_group_t>(g));
+		G.id = id++;
+		G.gems = static_cast<int>(g.gem_value());
+		G.gold = static_cast<int>(g.gold_value());
+		G.respawn = g.max_respawn_timer();
+		long sx = 0, sy = 0;
+		for (const auto& c : g.camps())
+		{
+			auto& s = cs[static_cast<std::size_t>(c.kind())];
+			if (!s)
+				s = c.base_stats();
+			G.camps.push_back(CampRef{ c, c.spawn_position(), s->base_health, s->base_strength });
+			G.hp.push_back(s->base_health);
+			G.mask.set(c.spawn_position());
+			G.max_hp += s->base_health;
+			if (s->base_strength > 0)
+				G.harmless = false;
+			sx += c.spawn_position().x, sy += c.spawn_position().y;
+			G.d_ally = std::min(G.d_ally, home.get(c.spawn_position()));
+			G.d_enemy = std::min(G.d_enemy, away.get(c.spawn_position()));
+		}
+		const int cnt = static_cast<int>(G.camps.size());
+		const vec2 mean{ static_cast<int>(sx / std::max(1, cnt)), static_cast<int>(sy / std::max(1, cnt)) };
+		G.center = G.camps.front().pos;
+		for (const auto& c : G.camps)
+			if (cheb(c.pos, mean) < cheb(G.center, mean))
+				G.center = c.pos;
+		int best = 0;
+		for (const auto& a : G.camps)
+		{
+			int k = 0;
+			for (const auto& b : G.camps)
+				k += cheb(a.pos, b.pos) <= 1;
+			best = std::max(best, k);
+		}
+		G.cluster = best <= 1 ? 1.f : (static_cast<float>(best) + 1.f) * 0.5f + (best >= 3 ? 0.2f : 0.f);
+		groups.push_back(std::move(G));
+	}
+}
+
+// ---- per-turn perception -----------------------------------------------------------------------------------------
+void Bot::refresh_self(bool full)
+{
+	bc::detail::champion_info ci{};
+	if (!read_ch(me_h, ci))
+		return;
+	pos = { ci.x, ci.y };
+	hp = ci.health;
+	max_hp = std::max(1.f, ci.max_health);
+	str = ci.strength;
+	focus = ci.focus;
+	state = ci.state;
+	range = ci.attack_range;
+	if (full)
+	{
+		auto& me = bc::self();
+		try { gold = static_cast<int>(me.gold_count()); } catch (...) { gold = 0; }
+		try { bag = static_cast<int>(me.gem_count()); } catch (...) { bag = 0; }
+	}
+}
+
+void Bot::perceive()
+{
+	round = static_cast<int>(bc::round_number());
+	refresh_self(true);
+	on_spawn = ally_spawn.is_set(pos);
+	dyn_ready = false;
+	std::uint8_t buf[8] = {};
+	bc::detail::sdk_read_shared_memory(0, buf, 8);
+	for (int i = 0; i < 8; ++i)
+		claims[static_cast<std::size_t>(i)] = buf[i];
+
+	for (auto& e : enemies)
+	{
+		std::int32_t alive = 1;
+		if (bc::detail::sdk_champion_is_alive(e.h, &alive) == 0)
+			e.alive = alive != 0;
+		bc::detail::champion_info ci{};
+		e.vis = e.alive && read_ch(e.h, ci);
+		if (!e.vis)
+			continue;
+		e.type = static_cast<bc::champion_type>(ci.type);
+		e.pos = { ci.x, ci.y };
+		e.hp = ci.health;
+		e.max_hp = std::max(1.f, ci.max_health);
+		e.str = ci.strength;
+		e.focus = ci.focus;
+		e.state = ci.state;
+		e.seen = round;
+		for (std::uint32_t s = 0; s < 2; ++s)
+		{
+			std::int32_t c = 0;
+			e.cd[s] = bc::detail::sdk_champion_cooldown(e.h, s, &c) == 0 ? c : 0;
+		}
+	}
+	for (auto& a : allies)
+	{
+		std::int32_t alive = 1;
+		if (bc::detail::sdk_champion_is_alive(a.h, &alive) == 0)
+			a.alive = alive != 0;
+		if (a.h == me_h)
+		{
+			a.vis = false;
+			continue;
+		}
+		bc::detail::champion_info ci{};
+		a.vis = a.alive && read_ch(a.h, ci);
+		if (!a.vis)
+			continue;
+		a.type = static_cast<bc::champion_type>(ci.type);
+		a.pos = { ci.x, ci.y };
+		a.hp = ci.health;
+		a.max_hp = std::max(1.f, ci.max_health);
+		a.str = ci.strength;
+		a.focus = ci.focus;
+		a.state = ci.state;
+		a.seen = round;
+	}
+
+	// Camp-group beliefs: the raw state call reports 0 for groups we cannot see.
+	for (auto& g : groups)
+	{
+		std::uint32_t s = 0;
+		if (bc::detail::sdk_camp_group_state(g.handle, &s) == 0 && s != 0)
+		{
+			g.seen = round;
+			if (s == 1)
+			{
+				g.st = G_ALIVE;
+				for (std::size_t i = 0; i < g.camps.size(); ++i)
+				{
+					// A dead camp has no live record (sdk_camp fails), only state 0.
+					std::uint32_t cst = 1;
+					if (bc::detail::sdk_camp_state(hid(g.camps[i].camp), &cst) != 0)
+						continue; // not visible: keep the last belief
+					bc::detail::camp_state cs{};
+					g.hp[i] = cst == 0 ? 0.f : (bc::detail::sdk_camp(hid(g.camps[i].camp), &cs) == 0 ? cs.health : g.hp[i]);
+				}
+			}
+			else if (s == 2)
+			{
+				g.st = G_REWARD;
+				for (auto& h : g.hp)
+					h = 0;
+			}
+			else
+			{
+				std::int32_t t = 0;
+				bc::detail::sdk_camp_group_cooldown(g.handle, &t);
+				g.st = G_RESPAWN;
+				g.ready = round + t;
+				for (auto& h : g.hp)
+					h = 0;
+			}
+		}
+		else if (g.st == G_RESPAWN && round >= g.ready)
+		{
+			g.st = G_ALIVE;
+			for (std::size_t i = 0; i < g.camps.size(); ++i)
+				g.hp[i] = g.camps[i].max_hp;
+		}
+		else if (g.st == G_REWARD && round - g.seen > 10)
+		{
+			g.st = G_RESPAWN;
+			g.ready = g.seen + 6 + g.respawn;
+		}
+	}
+}
