+		why = "f_cornered";
+		// Cannot run (or about to finish someone): fight back with whatever is in reach.
+		if (!reach.empty())
+		{
+			cast_on_enemies(spell, false);
+			const int f = pick_focus(reach);
+			if (f >= 0 && attack_ent(enemies[static_cast<std::size_t>(f)]))
+				if (kit.reset >= 0 && ability_ready(kit.reset) && cast_ability(kit.reset, nullptr, pos))
+					attack_ent(enemies[static_cast<std::size_t>(f)]);
+		}
+		return true;
+	}
+
+	// ---- engage decision ----
+	const bool engage = !reach.empty() || (dmin <= ENGAGE_R && (ratio >= ENGAGE_RATIO || (under_fire && ratio >= 0.7f)));
+	if (!engage)
+	{
+		// Badly outmatched and the enemy is not on us yet: back off toward home instead of farming into them.
+		if (dmin <= ENGAGE_R + 1 && ratio < 0.7f && !on_spawn)
+		{
+			why = "f_backoff";
+			if (flee_step())
+				return true;
+		}
+		return false;
+	}
+
+	why = "f_attack";
+	// ---- act: shield / cast, hit what is in reach FIRST, reset, then walk ----
+	std::vector<int>& cands = !spell.empty() ? spell : reach;
+	bool acted = false;
+	// 1. the self shield before the first trade (Varg), when an enemy is about to be in reach
+	if (kit.shield >= 0 && ability_ready(kit.shield) && dmin <= range + 1 && !(kit.reset >= 0 && !reach.empty() && ability_ready(kit.reset) && false))
+		acted |= cast_ability(kit.shield, nullptr, pos);
+	// 2. damage spell / stun on the best target in range (not for a melee body that must walk first with an exclusive spell)
+	if (!acted && !spell.empty())
+		acted |= cast_on_enemies(spell, false);
+	// 3. basic attack on the focus target
+	std::vector<int> reach2;
+	for (int i : reach)
+		if (enemies[static_cast<std::size_t>(i)].hp > 0)
+			reach2.push_back(i);
+	bool attacked = false;
+	if (!reach2.empty())
+	{
+		const int f = pick_focus(reach2);
+		if (f >= 0)
+			attacked = attack_ent(enemies[static_cast<std::size_t>(f)]);
+		// 4. attack reset gives a second swing
+		if (attacked && kit.reset >= 0 && ability_ready(kit.reset))
+			if (cast_ability(kit.reset, nullptr, pos) && f >= 0)
+				attack_ent(enemies[static_cast<std::size_t>(f)]);
+	}
+	if (attacked || acted)
+	{
+		// Melee that is outmatched steps back after its hit (attack, then move); everyone else holds the ground.
+		if (melee && attacked && ratio < 0.5f && can_move && !on_spawn)
+			flee_step();
+		return true;
+	}
+
+	// 5. nothing in reach: walk toward the nearest worthwhile enemy, then swing if the step brought it into reach
+	int tgt = -1, td = BIG;
+	for (int i : near)
+	{
+		const auto& e = enemies[static_cast<std::size_t>(i)];
+		if (enemy_spawn.is_set(e.pos))
+			continue;
+		const int d = cheb(e.pos, pos);
+		if (d < td)
+			td = d, tgt = i;
+	}
+	if (tgt < 0)
+		return false;
+	why = "f_walk";
+	auto& te = enemies[static_cast<std::size_t>(tgt)];
+	if (walk_toward(te.pos, std::max(1, range - (melee ? 0 : 0))))
+	{
+		if (cheb(pos, te.pos) <= range)
+		{
+			attack_ent(te);
+			if (kit.reset >= 0 && ability_ready(kit.reset) && !flag(state, bc::champion_state::can_attack))
+				if (cast_ability(kit.reset, nullptr, pos))
+					attack_ent(te);
+		}
+		return true;
+	}
+	return false;
 }
+
+// ---- banking ------------------------------------------------------------------------------------------------------
+bool Bot::bank()
+{
+	if (bag <= 0 || !altar_f.ready)
+		return false;
+	const int d = altar_f.get(pos);
+	if (d >= BIG)
+		return false;
+	const int submitted = static_cast<int>(bc::global_submitted_gems(team::ally));
+	const bool wins = submitted + bag >= static_cast<int>(bc::constants::winning_gems);
+	if (!(bag >= BANK_BAG || (d <= BANK_NEAR && bag >= BANK_NEAR_MIN) || wins))
+		return false;
+	if (enemy_near(ENEMY_CLEAR - 3) && !wins && d > 3)
+		return false;
+	auto& me = bc::self();
+	if (d == 0 || true)
+	{
+		const int rng = std::max<int>(1, bc::constants::submit_gems_range);
+		for (std::size_t i = 0; i < altars.size(); ++i)
+		{
+			if (cheb(altars[i], pos) > rng || altar_bad[i] > round)
+				continue;
+			bool locked = false;
+			try { locked = bc::vision::has_altar_lock(altars[i]); } catch (...) {}
+			if (locked)
+			{
+				altar_bad[i] = round + 30;
+				continue;
+			}
+			try
+			{
+				me.submit_gems(altars[i]);
+				return true;
+			}
+			catch (...)
+			{
+			}
+		}
+	}
+	if (walk_field(altar_f, 0))
+	{
+		// Tribute in the same turn when the step landed within range.
+		const int rng = std::max<int>(1, bc::constants::submit_gems_range);
+		for (std::size_t i = 0; i < altars.size(); ++i)
+			if (cheb(altars[i], pos) <= rng && altar_bad[i] <= round)
+			{
+				try { me.submit_gems(altars[i]); } catch (...) {}
+				break;
+			}
+		return true;
+	}
+	return false;
+}
+
+// ---- farming --------------------------------------------------------------------------------------------------------
+// Expected damage taken killing a group (camps die in health order; each live camp in range hits us) and kill time.
+// Walking field to a group, built on demand (13-19k fuel on a 100x100 map), kept for the rest of the game.
+Field* Bot::gfield(int id)
+{
+	if (gfields.size() != groups.size())
+		gfields.assign(groups.size(), Field{});
+	auto& f = gfields[static_cast<std::size_t>(id)];
+	if (!f.ready)
+	{
+		if (bc::fuel_remaining() < 45000)
+			return nullptr;
+		const auto& roots = groups[static_cast<std::size_t>(id)].mask;
+		bc::bitboard visited;
+		f.f.compute(walls & ~roots, roots, visited);
+		f.ready = true;
+	}
+	return &f;
+}
+
+float Bot::estimate_taken(const Group& g, float dps, float& time, float tank_mult)
+{
+	std::array<std::pair<float, float>, 12> v{};
+	int n = 0;
+	float sum_str = 0;
+	for (std::size_t i = 0; i < g.camps.size() && n < 12; ++i)
+		if (g.hp[i] > 0)
+		{
+			v[static_cast<std::size_t>(n++)] = { g.hp[i], g.camps[i].str };
+			sum_str += g.camps[i].str;
+		}
+	std::sort(v.begin(), v.begin() + n);
+	const float eff = std::max(1.f, dps * (my_type == bc::champion_type::varg ? g.cluster : 1.f));
+	float taken = 0;
+	time = 0;
+	for (int i = 0; i < n; ++i)
+	{
+		const float tk = v[static_cast<std::size_t>(i)].first / eff;
+		taken += sum_str * tk * tank_mult;
+		sum_str -= v[static_cast<std::size_t>(i)].second;
+		time += tk;
+	}
+	return taken;
+}
+
+int Bot::choose_group(int pass)
+{
+	// Walking distances from where we stand: one field per decision, Chebyshev estimates when fuel is short.
+	Field from;
+	bool have = false;
+	if (bc::fuel_remaining() > 60000)
+	{
+		bc::bitboard roots, visited;
+		roots.set(pos);
+		from.f.compute(walls & ~roots, roots, visited);
+		from.ready = true;
+		have = true;
+	}
+	// Cassi and Issac die together wherever they are: they farm one group as a pair (the second follows the first's claim).
+	if (my_type == bc::champion_type::cassi || my_type == bc::champion_type::issac)
+	{
+		const auto other = my_type == bc::champion_type::cassi ? bc::champion_type::issac : bc::champion_type::cassi;
+		for (std::size_t i = 0; i < allies.size() && i < 8; ++i)
+			if (allies[i].h != me_h && allies[i].type == other && allies[i].alive && claims[i] > 0 &&
+				claims[i] - 1 < static_cast<int>(groups.size()))
+			{
+				const auto& pg = groups[static_cast<std::size_t>(claims[i] - 1)];
+				if (pg.bl_until <= round && !(pg.st == G_RESPAWN && pg.ready - round > 25))
+					return pg.id;
+			}
+	}
+	const float my_dps = dps_of(kit, str, focus);
+	int best = -1;
+	float best_s = 0;
+	for (auto& g : groups)
+	{
+		if (g.bl_until > round)
+			continue;
+		if (pass == 0 && g.d_ally + 2 > g.d_enemy)
+			continue;
+		if (pass == 1 && !g.own())
+			continue;
+		if (g.d_ally >= BIG)
+			continue;
+		int travel = BIG;
+		if (have)
+		{
+			for (const auto& c : g.camps)
+				travel = std::min(travel, from.get(c.pos));
+		}
+		else
+			travel = static_cast<int>(1.3f * static_cast<float>(cheb(pos, g.center)));
+		if (travel >= BIG)
+			continue;
+		const auto claimants = ally_claimants(g.id);
+		float t_kill = 0, taken = 0;
+		bool pair_job = false;
+		if (g.st == G_ALIVE)
+		{
+			taken = estimate_taken(g, my_dps, t_kill, 1.f);
+			if (taken > 1.6f * max_hp)
+			{
+				// Too heavy alone: a pair job (two bodies on one group) when both together can do it.
+				float t2 = 0;
+				const float tk2 = estimate_taken(g, my_dps * 2.f, t2, 1.f);
+				if (tk2 > 1.6f * max_hp)
+					continue;
+				pair_job = true;
+				t_kill = t2;
+			}
+		}
+		if (claimants.size() >= 2)
+			continue;
+		if (claimants.size() == 1 && !pair_job)
+			continue; // a plain group is one body's job
+		if (claimants.empty() && pair_job && taken > 3.0f * max_hp)
+			continue; // far too heavy to start alone (damage persists, so a lone start with a heal trip is fine below that)
+		float wait = 0;
+		if (g.st == G_RESPAWN)
+			wait = static_cast<float>(std::max(0, g.ready - round));
+		if (wait > static_cast<float>(travel) + 20.f)
+			continue; // not worth waiting for
+		const float trips = taken > 0.7f * max_hp ? 1.f : 0.f;
+		const float time = std::max(static_cast<float>(travel), wait) + t_kill + 6.f + trips * 25.f;
+		float value = static_cast<float>(g.gems) + 0.3f * static_cast<float>(g.gold);
+		if (pair_job && claimants.empty())
+			value *= 0.6f; // a long job alone
+		float s = value / std::max(1.f, time);
+		// Seen enemies near the group lately: skip.
+		for (const auto& e : enemies)
+			if (e.vis && cheb(e.pos, g.center) <= 5)
+				s *= 0.3f;
+		if (s > best_s)
+			best_s = s, best = g.id;
+	}
+	return best;
+}
+
+bool Bot::farm()
+{
+	auto& me = bc::self();
+	// Validate the current target.
+	if (target >= 0)
+	{
+		auto& g = groups[static_cast<std::size_t>(target)];
+		bool drop = g.bl_until > round;
+		if (g.st == G_RESPAWN && g.ready - round > 25 && !g.mask.is_set(pos))
+			drop = true;
+		if (g.st == G_RESPAWN && round - target_since > 0 && g.ready - round > 25)
+			drop = true;
+		if (!drop)
+		{
+			// Somebody else claimed it before us (two bodies picked in the same round): the lower index yields.
+			const auto cl = ally_claimants(target);
+			const bool pair_ok = cl.size() <= 1;
+			if (!pair_ok)
+				drop = true;
+		}
+		if (drop)
+		{
+			target = -1;
+			write_claim(-1);
+		}
+	}
+	if (target < 0 || round - target_since > 400)
+	{
+		int t = choose_group(0);
+		if (t < 0)
+			t = choose_group(1);
+		if (t < 0)
+			t = choose_group(2);
+		if (t != target)
+			target_since = round, hold_since = -1;
+		target = t;
+		write_claim(target);
+	}
+	if (target < 0)
+		return false;
+	auto& g = groups[static_cast<std::size_t>(target)];
+	const bool on_tile = g.mask.is_set(pos);
+
+	// ---- reward available: step on a group tile and wait for the capture ----
+	if (g.st == G_REWARD)
+	{
+		if (on_tile)
+		{
+			why = "capture";
+			// The better converter captures: yield when a better-ranked claimant stands within 3 of the group.
+			for (std::size_t i = 0; i < allies.size(); ++i)
+				if (allies[i].h != me_h && allies[i].vis && allies[i].alive && cheb(allies[i].pos, g.center) <= 3 &&
+					rank_of(allies[i].type) > rank_of(my_type))
+				{
+					g.bl_until = round + 20;
+					target = -1;
+					write_claim(-1);
+					return false;
+				}
+			// Recall now (the capture lands with the teleport) when hurt or rich, if nobody can interrupt it.
+			if ((hp < RECALL_HP * max_hp || gold >= RECALL_GOLD) && !enemy_near(ENEMY_CLEAR) &&
+				!flag(state, bc::champion_state::recalling) && round - last_recall > 6)
+			{
+				try { me.recall(); last_recall = round; } catch (...) {}
+			}
+			return true;
+		}
+		why = "reward_walk";
+		why = "reward_walk";
+		if (Field* f = gfield(g.id))
+			if (walk_field(*f, 0))
+				return true;
+		return walk_toward(g.center, 0);
+	}
+
+	// ---- waiting for a respawn: stand next to the group, never on its tiles ----
+	if (g.st == G_RESPAWN)
+	{
+		why = "respawn_wait";
+		if (cheb(pos, g.center) <= 3 + (range > 1 ? 1 : 0))
+			return true;
+		if (!walk_toward(g.center, 2))
+		{
+			// No path greedy: dynamic search to the centre area.
+			return walk_toward(g.center, 3);
+		}
+		return true;
+	}
+
+	// ---- alive: fight camps ----
+	std::vector<int> live;
+	for (std::size_t i = 0; i < g.camps.size(); ++i)
+		if (g.hp[i] > 0)
+			live.push_back(static_cast<int>(i));
+	if (live.empty())
+	{
+		// Belief says nothing alive but the state is "alive": go look.
+		if (cheb(pos, g.center) <= 2)
+		{
+			g.bl_until = round + 30; // spurious: skip it for a while
+			target = -1;
+			write_claim(-1);
+			return false;
+		}
+		return walk_toward(g.center, 1);
+	}
+	int nearest_live = -1, nd = BIG;
+	for (int i : live)
+	{
+		const int d = cheb(pos, g.camps[static_cast<std::size_t>(i)].pos);
+		if (d < nd)
+			nd = d, nearest_live = i;
+	}
+	// Targets in reach.
+	std::vector<int> inreach;
+	for (int i : live)
+		if (cheb(pos, g.camps[static_cast<std::size_t>(i)].pos) <= range)
+			inreach.push_back(i);
+	if (!inreach.empty())
+	{
+		why = "hit";
+		int pick = inreach.front();
+		float bs = 1e30f;
+		for (int i : inreach)
+		{
+			float s = g.hp[static_cast<std::size_t>(i)];
+			if (my_type == bc::champion_type::varg)
+			{
+				int k = 0;
+				for (int j : live)
+					k += cheb(g.camps[static_cast<std::size_t>(j)].pos, g.camps[static_cast<std::size_t>(i)].pos) <= 1;
+				s -= 400.f * static_cast<float>(k - 1);
+			}
+			if (s < bs)
+				bs = s, pick = i;
+		}
+		const auto& camp = g.camps[static_cast<std::size_t>(pick)].camp;
+		bool done = false;
+		// Spells on camps unless an enemy is close enough to want them.
+		if (!enemy_near(9) && flag(state, bc::champion_state::can_cast))
+		{
+			for (int slot : { kit.dmg, kit.aoe })
+				if (!done && slot >= 0 && ability_ready(slot))
+				{
+					try
+					{
+						const auto ab = me.abilities()[static_cast<std::size_t>(slot)];
+						const float r = slot == kit.dmg ? kit.dmg_range : kit.aoe_range;
+						if (ab.can_target_camps() && static_cast<float>(cheb(pos, g.camps[static_cast<std::size_t>(pick)].pos)) <= r)
+							done = ab.use(camp);
+					}
+					catch (...)
+					{
+					}
+				}
+		}
+		if (flag(state, bc::champion_state::can_attack))
+		{
+			try { me.attack(camp); done = true; } catch (...) {}
+			refresh_self();
+			if (kit.reset >= 0 && ability_ready(kit.reset) && !enemy_near(9))
+			{
+				if (cast_ability(kit.reset, nullptr, pos))
+					try { me.attack(camp); } catch (...) {}
+			}
+		}
+		return true;
+	}
+	// Spells reach further than the basic attack (casters cast from 4 and take no camp hits).
+	if (!enemy_near(9) && flag(state, bc::champion_state::can_cast))
+	{
+		for (int slot : { kit.dmg, kit.aoe })
+			if (slot >= 0 && ability_ready(slot))
+			{
+				const float r = slot == kit.dmg ? kit.dmg_range : kit.aoe_range;
+				for (int i : live)
+					if (static_cast<float>(cheb(pos, g.camps[static_cast<std::size_t>(i)].pos)) <= r)
+					{
+						try
+						{
+							const auto ab = me.abilities()[static_cast<std::size_t>(slot)];
+							if (ab.can_target_camps() && ab.use(g.camps[static_cast<std::size_t>(i)].camp))
+							{
+								refresh_self();
+								return true;
+							}
+						}
+						catch (...)
+						{
+						}
+						break;
+					}
+			}
+	}
+	why = "walk";
+	why = "walk";
+	// Walk to the group along its field (units sidestepped); greedy Chebyshev only when no field is available.
+	const vec2 tp = g.camps[static_cast<std::size_t>(nearest_live)].pos;
+	bool moved = false;
+	if (Field* f = gfield(g.id))
+		moved = walk_field(*f, 0);
+	if (!moved)
+		moved = walk_toward(tp, range);
+	if (moved && cheb(pos, tp) <= range && flag(state, bc::champion_state::can_attack))
+		try { me.attack(g.camps[static_cast<std::size_t>(nearest_live)].camp); } catch (...) {}
+	return moved;
+}
+
+void Bot::set_prio(int nearest)
+{
+	int p = 100;
+	if (nearest <= 7)
+		p = 1000 - 20 * nearest;
+	if (nearest <= 9 && kit.cc >= 0 && ability_ready(kit.cc))
+		p += 300; // stunners go first so the stun lands before the target acts
+	try { bc::self().set_priority(p); } catch (...) {}
+}
+
+// ---- the turn -------------------------------------------------------------------------------------------------------
+void Bot::turn()
+{
+	if (!inited)
+		init();
+	perceive();
+	auto& me = bc::self();
+
+	// Dead bodies may shop; nothing else.
+	std::int32_t alive = 1;
+	bc::detail::sdk_champion_is_alive(me_h, &alive);
+	if (!alive)
+	{
+		write_claim(-1);
+		target = -1;
+		if (gold >= 30)
+			shop();
+		return;
+	}
+
+	int nearest = BIG;
+	for (const auto& e : enemies)
+		if (e.vis)
+			nearest = std::min(nearest, cheb(e.pos, pos));
+	struct Done
+	{
+		Bot* b;
+		int n;
+		~Done()
+		{
+			b->set_prio(n);
+			b->prev_hp = b->hp;
+#ifdef TOP_TRACE
+			const auto& g = b->groups[static_cast<std::size_t>(std::max(0, b->target))];
+			std::printf("T r=%d b=%d pos=%d,%d hp=%.0f bag=%d gold=%d tgt=%d st=%d rdy=%d why=%s\n", b->round, b->my_index, b->pos.x, b->pos.y, b->hp, b->bag, b->gold,
+						b->target, b->target >= 0 ? static_cast<int>(g.st) : -1, g.ready, b->why);
+#endif
+		}
+	} done{ this, nearest };
+	why = "";
+
+	// Channels run on their own.
+	if (flag(state, bc::champion_state::recalling) || flag(state, bc::champion_state::submitting_gems) ||
+		flag(state, bc::champion_state::teleporting))
+		return;
+
+	if (on_spawn || my_type == bc::champion_type::tavi)
+		shop();
+
+	if (fight())
+		return;
+
+	// Rest on spawn until healed (health is restored when a turn ends there).
+	if (on_spawn && hp < 0.95f * max_hp)
+		return;
+
+	// Badly hurt away from spawn: recall when nobody can interrupt it, else walk home.
+	if (hp < RETREAT_HP * max_hp && !on_spawn)
+	{
+		if (!enemy_near(ENEMY_CLEAR) && !camp_threat())
+		{
+			try { me.recall(); last_recall = round; } catch (...) {}
+			return;
+		}
+		if (flee_step())
+			return;
+	}
+
+	if (bank())
+	{
+		why = "bank";
+		return;
+	}
+
+	const vec2 before = pos;
+	if (farm())
+	{
+		// Watchdog: a walking body that never gets anywhere (blocked path) drops its target for a while.
+		const auto& g = groups[static_cast<std::size_t>(std::max(0, target))];
+		if (target >= 0 && pos == before && g.st == G_ALIVE && cheb(pos, g.center) > range + 1 && !flag(state, bc::champion_state::recalling))
+		{
+			if (++still > 12)
+			{
+				groups[static_cast<std::size_t>(target)].bl_until = round + 60;
+				target = -1;
+				write_claim(-1);
+				still = 0;
+			}
+		}
+		else
+			still = 0;
+		return;
+	}
+
+	// Nothing to do: go home and rest/shop rather than idle in the open.
+	if (!on_spawn)
+		flee_step();
+}
+} // namespace
+
+void play_turn() { B.turn(); }
