+inline int cheb(vec2 a, vec2 b)
+{
+	const int dx = a.x > b.x ? a.x - b.x : b.x - a.x;
+	const int dy = a.y > b.y ? a.y - b.y : b.y - a.y;
+	return dx > dy ? dx : dy;
+}
+
+inline std::uint32_t hid(const bc::champion& c) { return static_cast<std::uint32_t>(static_cast<bc::handle_champion_t>(c)); }
+inline std::uint32_t hid(const bc::camp& c) { return static_cast<std::uint32_t>(static_cast<bc::handle_camp_t>(c)); }
+inline bool flag(std::int32_t state, bc::champion_state f) { return (static_cast<std::uint32_t>(state) & f.bits()) == f.bits(); }
+
+bool read_ch(std::uint32_t h, bc::detail::champion_info& out)
+{
+	return bc::detail::sdk_champion(h, &out) == 0 && out.x >= 0 && out.y >= 0;
+}
