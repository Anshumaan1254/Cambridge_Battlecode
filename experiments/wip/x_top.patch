+				bk = k, bi = i;
+		}
+		if (bi >= 0)
+			opts.push_back({ kit.aoe, bi, focus * kit.aoe_mod * static_cast<float>(bk) * (kit.aoe >= 0 && kit.dmg < 0 ? 1.2f : 1.f), enemies[static_cast<std::size_t>(bi)].pos });
+	}
+	if (ability_ready(kit.cc) && !(may_move_after && kit.cc_x))
+	{
+		// Stun the most dangerous enemy in range (damage stat + focus), once per cooldown.
+		int bi = -1;
+		float bs = -1;
+		for (int i : cand)
