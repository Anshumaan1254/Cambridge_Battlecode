+float Brain::ward_score(vec2 t, const WardCtx& c, const bc::bitboard& bush) const
+{
+	// v11 ward value of tile t: what a ward there watches (vision 6) that the team cares about. The group and altar lists are
+	// filtered once per decision (smart_ward): scoring every group for each of the 25 tiles cost ~65k fuel and lost the turn.
+	const auto& W = world();
+	const int dh = W.dist_home(t), da = W.dist_away(t);
+	if (dh >= BIG || da >= BIG)
+		return -1.f;
+	float s = 0;
+	for (const auto& g : c.groups)
+		if (cheb(t, g.c) - g.r <= 6)
+			s += g.v;
+	for (const vec2 a : c.altars)
+		if (cheb(t, a) <= 6)
+			s += 30.f;
+	if (c.D < BIG && dh + da <= c.D + 4)
+		s += 20.f; // on the corridor between the spawns: their approach
+	if (bush.is_set(t))
+		s = s * 1.3f + 10.f; // a ward inside a bush reveals it (ENGINE_FACTS)
+	for (const vec2 o : c.others)
+		if (cheb(o, t) <= 5)
+		{
+			s *= 0.35f; // an ally ward already watches this
+			break;
+		}
+	return s;
+}
