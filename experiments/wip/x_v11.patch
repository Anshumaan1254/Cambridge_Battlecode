+bool Brain::smart_ward()
+{
+	// v11 (P.ward_smart): the best scored tile within placement reach (2); our standing ward moves only for a clearly better tile.
+	// Scored at most once per ward_round step (the first version re-scored every turn when it kept its ward: 15k lost turns in 12 games).
+	if (bc::fuel_remaining() < 30000)
+	{
+		ward_round = round - 9; // late in a heavy turn: try again next round
+		return false;
+	}
+	auto& W = world();
+	if (P.ward_smart == 1)
+		ward_round = round - 5; // next look in 5 rounds unless we place now (a placement sets the 10-round cooldown); 2 falls back to the default rule
+	static bc::bitboard bush = bc::map::bushes(); // static map data: fetched once
+	WardCtx c;
+	bool have = false;
+	try
+	{
+		for (const auto& wd : bc::vision::wards(team::ally))
+		{
+			const vec2 p = wd.position();
+			if (p == ward_pos)
+				have = true;
+			else
+				c.others.push_back(p);
+		}
+	}
+	catch (...)
+	{
+	}
+	for (const auto& g : W.groups)
+	{
+		if (g.d_ally >= BIG || g.d_enemy >= BIG || g.d_ally > g.d_enemy + 4)
+			continue; // our half and the contested middle
+		if (cheb(pos, g.center) - g.radius > 8 && !(have && cheb(ward_pos, g.center) - g.radius <= 6))
+			continue;
+		const float contest = 1.f + 4.f / (4.f + static_cast<float>(std::abs(g.d_enemy - g.d_ally)));
+		c.groups.push_back({ g.center, g.radius, (static_cast<float>(g.gems) + gold_v * static_cast<float>(g.gold)) * contest });
+	}
+	for (std::size_t i = 0; i < W.altars.size(); ++i)
+		if ((cheb(pos, W.altars[i]) <= 8 || (have && cheb(ward_pos, W.altars[i]) <= 6)) && altar_ours(i))
+			c.altars.push_back(W.altars[i]);
+	c.D = W.dist_home(W.enemy_spawn_c);
+	const Group* tg = P.ward_smart == 3 && task_group >= 0 && static_cast<std::size_t>(task_group) < W.groups.size() ?
+		&W.groups[static_cast<std::size_t>(task_group)] : nullptr;
+	const float cur = have && P.ward_smart == 1 ? ward_score(ward_pos, c, bush) : 0.f;
+	vec2 best{ -1, -1 };
+	float bs = 0.f;
+	for (int dy = -2; dy <= 2; ++dy)
+		for (int dx = -2; dx <= 2; ++dx)
+		{
+			const vec2 t = pos + vec2{ dx, dy };
+			if (!bc::map::is_in_bounds(t) || t == ward_pos || W.walls.is_set(t) || W.camp_occ.is_set(t))
+				continue;
+			float s = ward_score(t, c, bush);
+			if (P.ward_smart == 3 && tg && bush.is_set(t) && cheb(t, tg->center) <= tg->radius + 2 && s > 0.f)
+			{
+				// 3: a bush next to the group we work on comes first (the ambush persona farms and waits there; 2 lost its cell
+				// 20 vs 32 of 42), then the scouting tiles of 2.
+				s = 100.f + s * 0.25f;
+			}
+			else if (P.ward_smart >= 2)
+			{
+				// 2: a scouting ward, as the default rule (2 tiles toward their spawn: early warning measured better than watching our
+				// own camps, 1 lost 38.5% with +620 deaths), placed on the best such tile: ahead of us, a bush or a corridor tile.
+				const int ahead = W.dist_away(pos) - W.dist_away(t);
+				if (ahead <= 0 || s < 0.f)
+					continue;
+				s = s * 0.25f + 15.f * static_cast<float>(ahead);
+			}
+			if (s > bs)
+				bs = s, best = t;
+		}
+	if (best.x < 0 || bs <= 0.f || (P.ward_smart == 1 && have && bs < P.ward_keep * cur + 5.f))
+		return false;
+	try
+	{
+		if (bc::self().place_ward(best))
+		{
+			ward_round = round;
+			ward_pos = best;
+			return true;
+		}
+	}
+	catch (...)
+	{
+	}
+	return false;
+}
