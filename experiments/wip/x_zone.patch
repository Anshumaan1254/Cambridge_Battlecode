@@ -0,0 +1,348 @@
+#include "zone.h"
+#include "params.h"
+#include "world.h"
+
+ZonePlan& zones()
+{
+	static ZonePlan z;
+	return z;
+}
+
+bool ZonePlan::unit_alive(int u) const
+{
+	const auto& W = world();
+	for (std::size_t i = 0; i < W.allies.size() && i < unit_of.size(); ++i)
+		if (unit_of[i] == u && W.allies[i].alive)
+			return true;
+	return false;
+}
+
+namespace
+{
+using CT = bc::champion_type;
+
+// One body's base facts (designs: no live state), read once per body: kit_of() walks the abilities through host calls.
+struct BodyFacts
+{
+	CT t;
+	float str, focus, hp;
+	Kit k;
+};
+
+// Damage per round of one body on group g at base stats (the same terms as Brain::dps_on: splash and radius-1 area spells hit
+// the packed camps, spells once per 8-round cooldown, Ren's retaliation per camp hitting him).
+float body_dps(const BodyFacts& b, const Group& g)
+{
+	const Kit& k = b.k;
+	const float cl = g.cluster;
+	float base = b.str * (1.f + (k.reset >= 0 ? 0.125f : 0.f));
+	if (b.t == CT::varg)
+		base *= cl;
+	float spells = 0;
+	if (k.dmg >= 0)
+		spells += b.focus * k.dmg_mod;
+	if (k.cc >= 0)
+		spells += b.focus * k.cc_mod;
+	if (k.aoe >= 0)
+		spells += b.focus * k.aoe_mod * (k.aoe_radius >= 1.f ? cl : 1.f);
+	float v = base + spells / 8.f;
+	if (b.t == CT::ren && !k.ranged)
+		v += bc::constants::passive_abilities::ren_retaliation_focus_ratio * b.focus * static_cast<float>(std::min(g.attackers, 3));
+	return v;
+}
+} // namespace
+
+void ZonePlan::build()
+{
+	ready = false;
+	auto& W = world();
+	if (P.zone_skip_obj && (W.obj_mode || W.mono_mode))
+		return;
+	const auto& mem = bc::draft_memory;
+	const std::size_t n = mem.size();
+	if (n < 6 || static_cast<int>(mem[0]) != 0xB9 || static_cast<int>(mem[1]) != 1)
+		return;
+	const int M = static_cast<int>(mem[2]);
+	if (static_cast<int>(mem[3]) != static_cast<int>(std::min<std::size_t>(255, W.groups.size())) || static_cast<int>(mem[4]) != (W.W & 255) ||
+		static_cast<int>(mem[5]) != (W.H & 255) || n < 6 + static_cast<std::size_t>(M) + static_cast<std::size_t>(M * (M - 1) / 2))
+		return;
+	src_m = M;
+	// Units: our picks. Cassi and Issac are one pick, two bodies, one zone (they die together).
+	unit_of.assign(W.allies.size(), -1);
+	std::vector<std::vector<BodyFacts>> units;
+	int ci_unit = -1;
+	for (std::size_t i = 0; i < W.allies.size(); ++i)
+	{
+		const CT t = W.allies[i].type;
+		const auto& dz = bc::champion_designs[static_cast<std::size_t>(t)];
+		const auto st = dz.base_stats();
+		const BodyFacts bf{ t, st.base_strength, st.base_focus, st.base_health, kit_of(dz) };
+		if (t == CT::cassi || t == CT::issac)
+		{
+			if (ci_unit < 0)
+				ci_unit = static_cast<int>(units.size()), units.emplace_back();
+			units[static_cast<std::size_t>(ci_unit)].push_back(bf);
+			unit_of[i] = ci_unit;
+		}
+		else
+		{
+			unit_of[i] = static_cast<int>(units.size());
+			units.push_back({ bf });
+		}
+	}
+	nunits = static_cast<int>(units.size());
+	my_unit = W.my_index >= 0 && W.my_index < static_cast<int>(unit_of.size()) ? unit_of[static_cast<std::size_t>(W.my_index)] : -1;
+	// Items: the measured groups that a body farms alone or with a partner (objective groups and monoliths are team plans).
+	std::vector<int> item, row; // group id, index in the draft matrix
+	for (int i = 0; i < M; ++i)
+	{
+		const int gid = static_cast<int>(mem[6 + static_cast<std::size_t>(i)]);
+		if (gid >= static_cast<int>(W.groups.size()))
+			return;
+		const auto& g = W.groups[static_cast<std::size_t>(gid)];
+		if (g.objective || g.monolith || g.d_ally >= BIG)
+			continue;
+		item.push_back(gid), row.push_back(i);
+	}
+	const int N = static_cast<int>(item.size());
+	nitems = N;
+	const int k = std::min(nunits, N);
+	zone_of.assign(W.groups.size(), -1);
+	medoid.assign(static_cast<std::size_t>(std::max(0, nunits)), -1);
+	if (k <= 0)
+		return;
+	std::vector<int> D(static_cast<std::size_t>(N * N), 0);
+	auto tri = [&](int i, int j) { // matrix rows i < j
+		const std::size_t r = static_cast<std::size_t>(i) * static_cast<std::size_t>(2 * M - i - 1) / 2;
+		return static_cast<int>(mem[6 + static_cast<std::size_t>(M) + r + static_cast<std::size_t>(j - i - 1)]);
+	};
+	for (int a = 0; a < N; ++a)
+		for (int b = a + 1; b < N; ++b)
+		{
+			const int i = row[static_cast<std::size_t>(a)], j = row[static_cast<std::size_t>(b)];
+			int d = i < j ? tri(i, j) : tri(j, i);
+			if (d >= 255)
+				d = 400; // unreachable on foot (islands): never one zone
+			D[static_cast<std::size_t>(a * N + b)] = D[static_cast<std::size_t>(b * N + a)] = d;
+		}
+	auto dist = [&](int a, int b) { return D[static_cast<std::size_t>(a * N + b)]; };
+	// Units' facts per group at base stats: damage per round (splash, area, retaliation) and how many heal trips a clear costs.
+	std::vector<float> ufit(static_cast<std::size_t>(nunits * N), 0.f), utrips(static_cast<std::size_t>(nunits * N), 0.f);
+	std::vector<float> w(static_cast<std::size_t>(N)), load(static_cast<std::size_t>(N));
+	std::vector<int> ubodies(static_cast<std::size_t>(nunits));
+	int bodies = 0;
+	for (int u = 0; u < nunits; ++u)
+		ubodies[static_cast<std::size_t>(u)] = static_cast<int>(units[static_cast<std::size_t>(u)].size()), bodies += ubodies[static_cast<std::size_t>(u)];
+	for (int a = 0; a < N; ++a)
+	{
+		const auto& g = W.groups[static_cast<std::size_t>(item[static_cast<std::size_t>(a)])];
+		const float v = static_cast<float>(g.gems) + P.gold_value * static_cast<float>(g.gold);
+		float dsum = 0;
+		for (int u = 0; u < nunits; ++u)
+		{
+			float hpu = 0, dps = 0;
+			bool melee = false;
+			for (const auto& b : units[static_cast<std::size_t>(u)])
+				hpu += b.hp, melee |= !b.k.ranged, dps += body_dps(b, g);
+			dsum += dps;
+			const float kill = g.max_hp / std::max(10.f, dps);
+			const float taken = g.dps * kill * (melee ? 1.f : P.ranged_exposure);
+			const float budget = 0.6f * std::max(1.f, hpu);
+			const float trips = std::max(0.f, taken - budget) / budget;
+			ufit[static_cast<std::size_t>(u * N + a)] = v / (kill + 6.f + trips * 25.f);
+			utrips[static_cast<std::size_t>(u * N + a)] = trips;
+		}
+		// Weight: value per round of its cycle; load: share of one body's time it takes to farm it at every respawn (clear with
+		// the team's mean damage, capture, a short hop).
+		const float kref = g.max_hp / std::max(10.f, dsum / static_cast<float>(std::max(1, bodies)));
+		w[static_cast<std::size_t>(a)] = v / (static_cast<float>(g.respawn) + 6.f + g.max_hp / 150.f);
+		load[static_cast<std::size_t>(a)] = (kref + 14.f) / (static_cast<float>(g.respawn) + kref + 6.f);
+	}
+	// Clustering distance. zone_shape 0: walking distance. 1: sectors around our spawn: the share of the walk between two groups
+	// that leaves the line through spawn, theta = (D - |dh_a - dh_b|) / (dh_a + dh_b - |dh_a - dh_b|) (0 on one ray, 1 when the
+	// walk goes back through spawn), plus zone_depth x walking distance. Trips are star-shaped (spawn, camps, recall home), so a
+	// sector keeps a body's near and far groups on one way out.
+	std::vector<float> X(static_cast<std::size_t>(N * N), 0.f);
+	for (int a = 0; a < N; ++a)
+		for (int b = a + 1; b < N; ++b)
+		{
+			const float d = static_cast<float>(dist(a, b));
+			float x = d;
+			if (P.zone_shape == 1)
+			{
+				const float ha = static_cast<float>(std::min(400, W.groups[static_cast<std::size_t>(item[static_cast<std::size_t>(a)])].d_ally));
+				const float hb = static_cast<float>(std::min(400, W.groups[static_cast<std::size_t>(item[static_cast<std::size_t>(b)])].d_ally));
+				const float lo = std::abs(ha - hb), hi = ha + hb;
+				const float th = hi - lo > 0.5f ? std::clamp((d - lo) / (hi - lo), 0.f, 1.f) : (d > 2.f ? 1.f : 0.f);
+				x = 100.f * th + P.zone_depth * d;
+			}
+			X[static_cast<std::size_t>(a * N + b)] = X[static_cast<std::size_t>(b * N + a)] = x;
+		}
+	auto xd = [&](int a, int b) { return X[static_cast<std::size_t>(a * N + b)]; };
+	// Weighted k-medoids, Voronoi iteration. Seeds: the most valuable group, then farthest-first.
+	std::vector<int> med;
+	{
+		int s0 = 0;
+		for (int a = 1; a < N; ++a)
+			if (w[static_cast<std::size_t>(a)] > w[static_cast<std::size_t>(s0)])
+				s0 = a;
+		med.push_back(s0);
+		while (static_cast<int>(med.size()) < k)
+		{
+			int best = -1;
+			float bd = -1.f;
+			for (int a = 0; a < N; ++a)
+			{
+				float md = 1e30f;
+				for (int m : med)
+					md = std::min(md, xd(a, m));
+				if (md > bd)
+					bd = md, best = a;
+			}
+			med.push_back(best);
+		}
+	}
+	std::vector<int> cl(static_cast<std::size_t>(N), 0);
+	auto voronoi = [&]() {
+		for (int a = 0; a < N; ++a)
+		{
+			int bc = 0;
+			float bd = 1e30f;
+			for (int c = 0; c < k; ++c)
+			{
+				const float d = xd(a, med[static_cast<std::size_t>(c)]);
+				if (d < bd)
+					bd = d, bc = c;
+			}
+			cl[static_cast<std::size_t>(a)] = bc;
+		}
+	};
+	auto update = [&]() {
+		bool moved = false;
+		for (int c = 0; c < k; ++c)
+		{
+			int best = med[static_cast<std::size_t>(c)];
+			float bcost = 1e30f;
+			for (int a = 0; a < N; ++a)
+			{
+				if (cl[static_cast<std::size_t>(a)] != c)
+					continue;
+				float cost = 0;
+				for (int b = 0; b < N; ++b)
+					if (cl[static_cast<std::size_t>(b)] == c)
+						cost += w[static_cast<std::size_t>(b)] * xd(a, b);
+				if (cost < bcost - 1e-4f)
+					bcost = cost, best = a;
+			}
+			moved |= best != med[static_cast<std::size_t>(c)];
+			med[static_cast<std::size_t>(c)] = best;
+		}
+		return moved;
+	};
+	for (int it = 0; it < 20; ++it)
+	{
+		voronoi();
+		if (!update())
+			break;
+	}
+	// Seed shares: the pick with the most bodies (Cassi & Issac) takes the cluster with the most load; the rest are equal.
+	std::vector<int> share(static_cast<std::size_t>(k), 1);
+	if (k == nunits)
+	{
+		std::vector<int> ord(static_cast<std::size_t>(nunits));
+		for (int u = 0; u < nunits; ++u)
+			ord[static_cast<std::size_t>(u)] = u;
+		std::stable_sort(ord.begin(), ord.end(), [&](int x, int y) { return ubodies[static_cast<std::size_t>(x)] > ubodies[static_cast<std::size_t>(y)]; });
+		std::vector<float> cload(static_cast<std::size_t>(k), 0.f);
+		for (int a = 0; a < N; ++a)
+			cload[static_cast<std::size_t>(cl[static_cast<std::size_t>(a)])] += load[static_cast<std::size_t>(a)];
+		std::vector<int> cord(static_cast<std::size_t>(k));
+		for (int c = 0; c < k; ++c)
+			cord[static_cast<std::size_t>(c)] = c;
+		std::stable_sort(cord.begin(), cord.end(), [&](int x, int y) { return cload[static_cast<std::size_t>(x)] > cload[static_cast<std::size_t>(y)]; });
+		for (int r = 0; r < k; ++r)
+			share[static_cast<std::size_t>(cord[static_cast<std::size_t>(r)])] = ubodies[static_cast<std::size_t>(ord[static_cast<std::size_t>(r)])];
+	}
+	if (P.zone_balance > 0.f && k == nunits && k > 1)
+	{
+		// Balanced zones: each cluster holds at most its share of the total load (x 1 + zone_balance); groups go to the nearest
+		// cluster with room, nearest pairs first.
+		float L = 0;
+		for (int a = 0; a < N; ++a)
+			L += load[static_cast<std::size_t>(a)];
+		std::vector<std::pair<float, int>> pairs;
+		pairs.reserve(static_cast<std::size_t>(N * k));
+		for (int it = 0; it < 10; ++it)
+		{
+			std::vector<float> cap(static_cast<std::size_t>(k)), cl_load(static_cast<std::size_t>(k), 0.f);
+			for (int c = 0; c < k; ++c)
+				cap[static_cast<std::size_t>(c)] = L * static_cast<float>(share[static_cast<std::size_t>(c)]) / static_cast<float>(bodies) * (1.f + P.zone_balance);
+			pairs.clear();
+			for (int a = 0; a < N; ++a)
+				for (int c = 0; c < k; ++c)
+					pairs.push_back({ xd(a, med[static_cast<std::size_t>(c)]), a * k + c });
+			std::stable_sort(pairs.begin(), pairs.end(), [](const auto& x, const auto& y) { return x.first < y.first; });
+			std::vector<int> nc(static_cast<std::size_t>(N), -1);
+			for (int c = 0; c < k; ++c) // every medoid stays in its own cluster
+				nc[static_cast<std::size_t>(med[static_cast<std::size_t>(c)])] = c, cl_load[static_cast<std::size_t>(c)] += load[static_cast<std::size_t>(med[static_cast<std::size_t>(c)])];
+			for (const auto& pr : pairs)
+			{
+				const int a = pr.second / k, c = pr.second % k;
+				if (nc[static_cast<std::size_t>(a)] >= 0 || cl_load[static_cast<std::size_t>(c)] + load[static_cast<std::size_t>(a)] > cap[static_cast<std::size_t>(c)])
+					continue;
+				nc[static_cast<std::size_t>(a)] = c, cl_load[static_cast<std::size_t>(c)] += load[static_cast<std::size_t>(a)];
+			}
+			for (int a = 0; a < N; ++a)
+				if (nc[static_cast<std::size_t>(a)] < 0)
+				{
+					// No room anywhere: the cluster least over its cap.
+					int bc = 0;
+					float bo = 1e30f;
+					for (int c = 0; c < k; ++c)
+					{
+						const float o = (cl_load[static_cast<std::size_t>(c)] + load[static_cast<std::size_t>(a)]) / cap[static_cast<std::size_t>(c)];
+						if (o < bo)
+							bo = o, bc = c;
+					}
+					nc[static_cast<std::size_t>(a)] = bc, cl_load[static_cast<std::size_t>(bc)] += load[static_cast<std::size_t>(a)];
+				}
+			cl = nc;
+			if (!update())
+				break;
+		}
+	}
+	// Who farms which zone: the assignment of picks to zones (with the same body count as the zone's share) with the best sum of
+	// farm rates, value / (clear + capture + heal trips), at base stats.
+	std::vector<float> zfit(static_cast<std::size_t>(nunits * k), 0.f);
+	for (int a = 0; a < N; ++a)
+		for (int u = 0; u < nunits; ++u)
+			zfit[static_cast<std::size_t>(u * k + cl[static_cast<std::size_t>(a)])] += ufit[static_cast<std::size_t>(u * N + a)];
+	std::vector<int> perm(static_cast<std::size_t>(nunits));
+	for (int u = 0; u < nunits; ++u)
+		perm[static_cast<std::size_t>(u)] = u;
+	std::vector<int> best_perm = perm;
+	float best = -1.f;
+	do
+	{
+		float s = 0;
+		bool ok = true;
+		for (int c = 0; c < k && ok; ++c)
+		{
+			const int u = perm[static_cast<std::size_t>(c)];
+			ok = k != nunits || ubodies[static_cast<std::size_t>(u)] == share[static_cast<std::size_t>(c)];
+			s += zfit[static_cast<std::size_t>(u * k + c)];
+		}
+		if (ok && s > best + 1e-6f)
+			best = s, best_perm = perm;
+	} while (std::next_permutation(perm.begin(), perm.end()));
+	for (int a = 0; a < N; ++a)
+	{
+		const int u = best_perm[static_cast<std::size_t>(cl[static_cast<std::size_t>(a)])];
+		// A group its owner cannot clear alone at base stats stays a team target (the join rules bring the helpers).
+		if (utrips[static_cast<std::size_t>(u * N + a)] <= P.zone_solo_trips)
+			zone_of[static_cast<std::size_t>(item[static_cast<std::size_t>(a)])] = u;
+	}
+	for (int c = 0; c < k; ++c)
+		medoid[static_cast<std::size_t>(best_perm[static_cast<std::size_t>(c)])] = item[static_cast<std::size_t>(med[static_cast<std::size_t>(c)])];
+	ready = true;
+}
diff -ruN _ch2/src/zone.h _x_zone/src/zone.h
--- _ch2/src/zone.h	1970-01-01 00:00:00.000000000 +0000
+++ _x_zone/src/zone.h	2026-10-19 21:10:30.857321868 +0000
@@ -0,0 +1,20 @@
+// Farming zones (P.zone_plan): the camp groups on our side split into one zone per pick, from the walking distances the first
+// draft turn leaves in draft memory (draft.cpp zone_draft). Every body computes the same plan from the same facts (draft memory,
+// the static camp table, our picks), so the zones agree without shared memory.
+#pragma once
+#include "common.h"
+
+struct ZonePlan
+{
+	bool ready = false;
+	int nunits = 0, my_unit = -1;
+	std::vector<int> zone_of;	   // per group: the pick (unit) that farms it, -1 for none
+	std::vector<int> unit_of;	   // per ally index: its unit (Cassi and Issac share one)
+	std::vector<int> medoid;	   // per unit: its zone's medoid group (-1 none)
+	int nitems = 0, src_m = 0;	   // trace: groups zoned, groups in draft memory
+	void build();
+	bool unit_alive(int u) const;
+	int zone(int group) const { return ready && group >= 0 && group < static_cast<int>(zone_of.size()) ? zone_of[static_cast<std::size_t>(group)] : -1; }
+};
+
+ZonePlan& zones();
