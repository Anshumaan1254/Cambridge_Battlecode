+float Brain::zone_mult(const Group& g) const
+{
+	// Farming zones: our own zone's groups are worth more to us, another pick's zone less while one of its bodies lives (it
+	// will come for them; the walk there is what the zones save). Unzoned groups (enemy side, objectives) are unchanged.
+	const auto& Z = zones();
+	if (!Z.ready || Z.my_unit < 0)
+		return 1.f;
+	const int z = Z.zone(g.id);
+	if (z < 0)
+		return 1.f;
+	if (z == Z.my_unit)
+		return P.zone_own;
+	return Z.unit_alive(z) ? P.zone_other : 1.f;
+}
