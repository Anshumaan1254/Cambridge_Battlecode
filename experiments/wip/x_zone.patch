+	int zone_idle = 0;			// 1: with nothing to farm, wait at the soonest respawn of our own zone (else the soonest on our half)
+	int zone_shape = 0;			// clustering distance: 0 walking distance between groups; 1 sectors around our spawn (zone.cpp)
+	float zone_depth = 0.2f;	// zone_shape 1: + this x walking distance
