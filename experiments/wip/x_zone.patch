+// P.zone_plan: walking distances between the camp groups on our side, measured once on the first draft turn (1M fuel; a
+// distance field costs 13-19k on 100x100, too much for the 100k of a game turn) and left in draft memory for the bodies
+// (zone.cpp builds the zones from it). Layout (zone.h): magic, version, M, groups, width, height, M group ids (nearest to our
+// spawn first), then the upper triangle of the M x M matrix, row by row (steps, 255 = unreachable or more).
+void zone_draft()
+{
+	const long long floor_fuel = 300000; // the pick still needs its share of the turn
+	const bc::bitboard terrain = bc::map::walls() | bc::map::holes();
+	const bc::bitboard ally = bc::map::spawn_region(team::ally), enemy = bc::map::spawn_region(team::enemy);
+	const bc::bitboard walls = terrain | bc::map::altars() | enemy;
+	bc::distance_field home, away;
+	bc::bitboard vis;
+	home.compute(walls, ally, vis);
+	away.compute(terrain | bc::map::altars() | ally, enemy, vis);
+	struct Cand
+	{
+		int id, dh;
+		vec2 tile;
+		bc::bitboard mask;
+	};
+	std::vector<Cand> cand;
+	const auto groups = bc::map::camp_groups();
+	cand.reserve(groups.size());
+	int id = 0;
+	for (const auto& g : groups)
+	{
+		int da = BIG, de = BIG;
+		bool mono = false;
+		Cand c{ id++, BIG, { -1, -1 }, {} };
+		for (const auto& cp : g.camps())
+		{
+			const vec2 p = cp.spawn_position();
+			const auto a = home.get(p), e = away.get(p);
+			const int ia = a == UNREACH ? BIG : static_cast<int>(a), ie = e == UNREACH ? BIG : static_cast<int>(e);
+			if (ia < da)
+				da = ia, c.tile = p;
+			de = std::min(de, ie);
+			c.mask.set(p);
+			mono |= cp.kind() == bc::camp_type::monolith;
+		}
+		if (da < BIG && !mono && da <= de + P.zone_band)
+		{
+			c.dh = da;
+			cand.push_back(std::move(c));
+		}
+	}
+	std::stable_sort(cand.begin(), cand.end(), [](const Cand& a, const Cand& b) { return a.dh < b.dh; });
+	constexpr std::size_t MMAX = 44; // 6 + 44 + 44 x 43 / 2 = 996 bytes of 1024
+	if (cand.size() > MMAX)
+		cand.resize(MMAX);
+	const int M = static_cast<int>(cand.size());
+	std::vector<std::uint8_t> mem(6 + static_cast<std::size_t>(M) + static_cast<std::size_t>(M * (M - 1) / 2), 255);
+	mem[0] = 0xB9, mem[1] = 1, mem[2] = static_cast<std::uint8_t>(M), mem[3] = static_cast<std::uint8_t>(std::min<std::size_t>(255, groups.size()));
+	mem[4] = static_cast<std::uint8_t>(bc::map::width()), mem[5] = static_cast<std::uint8_t>(bc::map::height());
+	for (int i = 0; i < M; ++i)
+		mem[6 + static_cast<std::size_t>(i)] = static_cast<std::uint8_t>(cand[static_cast<std::size_t>(i)].id);
+	auto at = [&](int i, int j) -> std::uint8_t& { // i < j
+		const std::size_t row = static_cast<std::size_t>(i) * static_cast<std::size_t>(2 * M - i - 1) / 2;
+		return mem[6 + static_cast<std::size_t>(M) + row + static_cast<std::size_t>(j - i - 1)];
+	};
+	int done = 0;
+	for (; done < M - 1 && static_cast<long long>(bc::fuel_remaining()) > floor_fuel; ++done)
+	{
+		bc::distance_field f;
+		f.compute(walls, cand[static_cast<std::size_t>(done)].mask, vis);
+		for (int j = done + 1; j < M; ++j)
+		{
+			const auto d = f.get(cand[static_cast<std::size_t>(j)].tile);
+			at(done, j) = d == UNREACH ? 255 : static_cast<std::uint8_t>(std::min<int>(254, d));
+		}
+	}
+	// Out of fuel: the pairs among the remaining groups are estimated (Chebyshev x 1.3; walls make walks longer).
+	for (int i = done; i < M; ++i)
+		for (int j = i + 1; j < M; ++j)
+			at(i, j) = static_cast<std::uint8_t>(std::min(254, cheb(cand[static_cast<std::size_t>(i)].tile, cand[static_cast<std::size_t>(j)].tile) * 13 / 10));
+	bc::draft_memory = mem;
+}
 } // namespace
 
