+	for (int k = 0; k < av_n && kb < 0; ++k)
+	{
+		const int de = cheb(g.center, av_pos[static_cast<std::size_t>(k)]);
+		if (de <= P.g24_pace_r && de < dme - 1)
+			kb = k;
+	}
+	if (kb < 0)
+		return false;
+	float tadv = -1.f;
